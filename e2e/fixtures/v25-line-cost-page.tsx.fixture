import type { V25WorkbenchCandidate, V25WorkbenchCosts } from '@/lib/domain/standard-estimate-v25-workbench';

/**
 * CI でのみ app/v25-e2e-line-cost/page.tsx にコピーする（公開のルートには無い）。
 * 正式な DB・版を一切参照・変更せず、実物の Excel 風明細で手入力明細の原価単価の入力を操作する（2026-11-20 の先方の依頼）。
 */
