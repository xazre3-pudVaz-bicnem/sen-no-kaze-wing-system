# =============================================================
# Wing 見積シミュレーター 環境変数
# 秘密値はこのファイルに書かない（.env.local に書く）
# =============================================================

# --- Supabase（本番・ステージング） -----------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。管理者作成スクリプト・見積PDF保存・管理画面の画像アップロードで使用。
# クライアントへ絶対に渡さない（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# 本番URL（例: https://wing.gijutsu.co.jp）
# 未設定のとき canonical / OGP / sitemap を出力せず robots は全Disallow（プレビューの誤インデックス防止）
NEXT_PUBLIC_SITE_URL=

# --- ローカル検証モード（Supabase なしで動かす） ----------------
# 1 にすると .wing-local/ 配下の JSON ファイルをデータベース代わりに使う。
# 開発・E2E テスト専用。本番では絶対に有効にしない。
# WING_LOCAL_MODE=1
# WING_LOCAL_DIR=.wing-local
# WING_LOCAL_SESSION_SECRET=change-me

# --- 任意 ------------------------------------------------------
# 見積依頼の通知先（未設定なら通知しない。Resend 等の送信処理は第二段階）
# QUOTE_NOTIFY_EMAIL=

# --- 電子契約（GMOサイン） -----------------------------------------
# 4 つすべてを設定したときだけ有効（未設定なら管理画面は送信できない旨を表示する）。
# 手順は docs/electronic-contract-gmosign.md。値は GMOサインの API 契約で発行される。
# GMOSIGN_CUSTOMER_ID=
# GMOSIGN_SECRET_KEY=
# GMOSIGN_TEMPLATE_ID=
# 通知先 URL（/api/webhooks/gmosign?token=...）に付ける推測できない文字列（例：openssl rand -hex 32）
# GMOSIGN_WEBHOOK_TOKEN=
# 任意：検証環境などの接続先（既定 https://api.gmo-exapi.net/gmosign）・送信者名
# GMOSIGN_API_BASE_URL=
# GMOSIGN_SENDER_NAME=
