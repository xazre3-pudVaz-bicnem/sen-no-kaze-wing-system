const candidates: V25WorkbenchCandidate[] = [
  { id: 'e2e-sash', name: '検査用サッシ', categoryId: 'cat-sash', categoryName: 'サッシ', categoryCode: 'sash', priceUnit: '台', section,
    singleSelect: false, manufacturer: '', modelNo: '', variantGroups: [], defaultChoices: {} },
];
const line = (key: string, name: string, extra: Partial<V25EditorState['lines'][number]> = {}) => ({
  key, line_key: key, section_code: section, group_label: '1. サッシ・木製建具工事', name, quantity: '1', unit: '式',
  price_mode: 'manual' as const, unit_price: '1000', remark: '', review_required: false, cost_unit_price: '', ...extra,
});
const initial: V25EditorState = {
  sales_fee_rate: '1', markup_rate: '1.5', expense_rate: '0.15', adjustment: '0', adjustment_reason: '',
  slots: [
    { key: 'sash', baseline_key: 'sash', option_id: 'e2e-sash', work_item: '1. サッシ・木製建具工事', variant_choices: {}, quantity: '1',
      price_mode: 'manual', manual_unit_price: '25000', slot_code: '', slot_label: '', selectable_option_ids: [] },
  ],
  lines: [
    line('costLine', '取付費', { quantity: '2', unit_price: '9000', cost_unit_price: '6000' }),
    line('noCostLine', '材料'),
    line('porLine', '外構工事', { price_mode: 'por', unit_price: '' }),
    // 本番に近い長い明細（横・縦のスクロールの中で操作する）
    ...Array.from({ length: 40 }, (_, i) => line('extra-' + i, '追加明細' + i, { cost_unit_price: String(500 + i) })),
  ],
};
const rule: PricingCalculationRule = {
  id: 'e2e-rule', formula_code: 'v2.5', rounding_mode: 'trunc',
  expense_target_sections: ['base', 'interior_exterior', 'option'],
  auto_price_sections: ['base', 'interior_exterior', 'option'],
};
const taxRule: PricingTaxRule = { id: 'e2e-tax', tax_mode: 'full_single_rate', tax_rate: '0.100000', rounding_mode: 'trunc' };
const costs: V25WorkbenchCosts = { pinned: {}, currentProduct: {}, currentChoice: {} };
export default function LineCostFixture() {
  return (
    <main className="mx-auto max-w-6xl p-4" data-testid="v25-line-cost-local-fixture">
